{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noImplicitAny": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "./src",
    "outDir": "./dist/types",
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist/**", "docs/**", "coverage/**", "node_modules/**"]
}
